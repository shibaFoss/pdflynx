server {
    listen 80;
    server_name pdflynx.com;

    # Frontend (Next.js server or static build)
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # Increase request size limit for PDF uploads
        client_max_body_size 50M;
    }

    # All traffic is handled through port 3000 (Next.js)
    # The PDF backend (port 5000) is now PRIVATE and only reachable 
    # via the Next.js Route Handler bridge.
}
