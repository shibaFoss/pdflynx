server {
    listen 80;
    server_name pdflynx.com; # Your domain

    # Frontend (Next.js server or static build)
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # Backend API (Fastify)
    # This location block proxies requests from /api/pdf to the internal backend
    location /api/pdf/ {
        proxy_pass http://localhost:5000/api/pdf/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Increase request size limit for PDF uploads
        client_max_body_size 50M;
    }
}
